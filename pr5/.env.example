# Налаштування для ПР5 «Семантичний пошук у колекції документів»
# Скопіюйте цей файл у .env перед початком роботи.

# Модель ембедінгів (Hugging Face Hub)
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Кількість результатів за замовчуванням
TOP_K=5
SEARCH_TOP_K=5

# Поріг схожості для семантичного пошуку (cosine similarity)
SEARCH_THRESHOLD=0.70
SIMILARITY_THRESHOLD=0.70

# Параметри поділу на фрагменти (chunking)
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Папки для документів та збереження індексу
INDEX_DIR=index
DOCS_DIR=docs
